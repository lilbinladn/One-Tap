rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email()    { return request.auth.token.email; }

    // Older accounts were made with just a username, stored as username@users.onetap-game.app.
    function isLegacy() { return email().matches('.*@users\\.onetap-game\\.app'); }

    // The head account is the username "micah" (stored as micah@users.onetap-game.app).
    // Register that username YOURSELF before anyone else can, because whoever owns that login is the head.
    function isHead() { return signedIn() && email() == 'micah@users.onetap-game.app'; }
    function isCurator() {
      return signedIn() && exists(/databases/$(database)/documents/curators/$(request.auth.uid));
    }
    function canCurate() { return isHead() || isCurator(); }

    // True when the signed-in account is the one that reserved this username.
    function ownsName(n) {
      return exists(/databases/$(database)/documents/usernames/$(n))
        && get(/databases/$(database)/documents/usernames/$(n)).data.uid == request.auth.uid;
    }

    // Each player's own progress and levels (same as before: only the owner can read or write).
    match /users/{uid}/data/{doc} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      // Anybody signed in may read ONE level document, but only while that level
      // (or its whole account) is featured in the community tab. Progress docs stay private.
      allow get: if signedIn()
        && doc.matches('c_.*')
        && ( exists(/databases/$(database)/documents/community/$('acct_' + uid))
          || exists(/databases/$(database)/documents/community/$('lvl_' + uid + '_' + doc)) );
    }

    // NEW: one document per username. It can be created once and never changed or removed,
    // which is what makes every username belong to exactly one account.
    // Accounts with a real email can claim any free name (except "micah", which only the head can take).
    // Older username-only accounts can only claim their own name.
    match /usernames/{name} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && name.matches('[a-z0-9._-]{3,24}')
        && (!isLegacy() || name == email().split('@')[0])
        && (name != 'micah' || isHead());
      allow update, delete: if false;
    }

    // Public index of a player's synced levels so curators can find them by username.
    // The name has to be the username this account reserved.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'lv', 'ts'])
        && request.resource.data.name is string
        && ( (isLegacy() && request.resource.data.name == email().split('@')[0])
          || ownsName(request.resource.data.name) );
      allow delete: if false;
    }

    // What shows up in the community tab. Head account and curators only.
    match /community/{id} {
      allow read: if signedIn();
      allow create, update, delete: if canCurate();
    }

    // Who the curators are. Only the head account can change this.
    match /curators/{uid} {
      allow read: if signedIn();
      allow write: if isHead();
    }
  }
}
